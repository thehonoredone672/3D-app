DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/propview?schema=public"
PORT=4100
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
# Comma-separated if you need more than one (e.g. local dev + a phone on your LAN)
CORS_ORIGIN="http://localhost:5173"
UPLOAD_DIR="uploads"
# Set both to enable HTTPS (required for camera access from a phone browser -
# see the root README's "Testing on a Phone" section for generating a
# self-signed cert). Leave unset for plain HTTP.
# SSL_KEY_PATH="../certs/dev.key"
# SSL_CERT_PATH="../certs/dev.crt"
SCAN_STORAGE_DIR="storage"
# "null" (default, no reconstruction available) or "local" (requires a real
# COLMAP install at COLMAP_PATH, and Python + trimesh at PYTHON_PATH - see
# backend/tools/README.md)
RECONSTRUCTION_PROVIDER="null"
# COLMAP_PATH="./tools/colmap/bin/colmap.exe"
# PYTHON_PATH="python"

# --- Production notes (see root README "Deploying to the Internet") ---
# - DATABASE_URL should point at a managed Postgres (e.g. Neon, Supabase).
# - CORS_ORIGIN should be your GitHub Pages URL, e.g.
#   "https://YOUR_GITHUB_USERNAME.github.io"
# - Leave RECONSTRUCTION_PROVIDER="null" unless you're running this on a
#   server with COLMAP + Python installed (see backend/tools/README.md).
# - UPLOAD_DIR / SCAN_STORAGE_DIR are local disk paths. On ephemeral hosts
#   (e.g. Render's free tier) their contents are wiped on every redeploy/
#   restart - fine for a demo, not for real user data. Swap for S3/R2/
#   Cloudinary before treating uploads as durable.
